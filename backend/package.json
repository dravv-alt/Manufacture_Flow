{
  "name": "machine-overwatch-backend",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "dev:live": "set APP_RUNTIME=live&& next dev -p 3001",
    "dev:demo": "set APP_RUNTIME=demo&& next dev -p 3002",
    "build": "next build",
    "start": "next start -p 3001",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:create:demo": "set APP_RUNTIME=live&& tsx scripts/create-demo-db.ts",
    "db:migrate:live": "set APP_RUNTIME=live&& drizzle-kit migrate",
    "db:migrate:demo": "set APP_RUNTIME=demo&& drizzle-kit migrate",
    "db:migrate:all": "npm run db:migrate:live && npm run db:migrate:demo",
    "db:seed": "set APP_RUNTIME=live&& tsx scripts/seed-db.ts",
    "db:seed:live": "set APP_RUNTIME=live&& tsx scripts/seed-db.ts",
    "db:seed:demo": "set APP_RUNTIME=demo&& tsx scripts/seed-demo.ts",
    "db:parity": "set APP_RUNTIME=live&& tsx scripts/validate-db-parity.ts",
    "validate:health:live": "set APP_RUNTIME=live&& tsx scripts/validate-runtime-health.ts",
    "validate:health:demo": "set APP_RUNTIME=demo&& tsx scripts/validate-runtime-health.ts",
    "validate:seed-idempotency": "set SEED_DB_IMPORT_ONLY=1&& set APP_RUNTIME=live&& tsx scripts/validate-seed-idempotency.ts",
    "validate:demo-isolation": "set APP_RUNTIME=demo&& tsx scripts/validate-demo-isolation.ts",
    "validate:recovery-time": "tsx scripts/validate-recovery-time.ts",
    "validate:production-rerouting": "tsx scripts/validate-production-rerouting.ts",
    "validate:delivery-impact": "tsx scripts/validate-delivery-impact.ts",
    "validate:final-notifications": "tsx scripts/validate-final-stakeholder-notifications.ts",
    "validate:maintenance-execution": "tsx scripts/validate-maintenance-execution.ts"
  }
}
